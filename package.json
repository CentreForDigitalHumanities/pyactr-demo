{
    "name": "pyactr-demo",
    "version": "0.1.1",
    "scripts": {
        "start": "yarn serve",
        "build": "ng build",
        "prebuild": "node ./build/build-pre.js",
        "watch": "ng build --watch",
        "test": "ng test --watch false",
        "pretest": "yarn prebuild",
        "preserve": "yarn prebuild",
        "serve": "ng serve",
        "serve:en": "ng serve --configuration=en",
        "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\""
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@acrodata/code-editor": "^0.6.1",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@codemirror/language-data": "^6.5.2",
        "@ng-bootstrap/ng-bootstrap": "21.0.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.6",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.3",
        "@angular/cli": "^22.2.3",
        "@angular/compiler-cli": "^22.2.3",
        "@angular/localize": "^22.2.3",
        "@types/jasmine": "~5.1.0",
        "colors": "^1.4.0",
        "istanbul-lib-instrument": "^6.0.3",
        "jsdom": "^30.1.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.0"
    }
}
